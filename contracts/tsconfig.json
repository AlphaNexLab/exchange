{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "types": ["mocha", "node"],
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "./hardhat.config.ts",
    "./config/**/*.ts",
    "./scripts/**/*.ts",
    "./test/**/*.ts",
    "./ignition/**/*.ts"
  ]
}
